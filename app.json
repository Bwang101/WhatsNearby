{
  "expo": {
    "name": "WhatsNearby",
    "slug": "WhatsNearby",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "whatsnearby",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "googlePlacesApiKey": "AIzaSyCABPaBddoeaVfI0q49pM5iLqRVCOF3xcE"
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyCABPaBddoeaVfI0q49pM5iLqRVCOF3xcE"
      },
      "bundleIdentifier": "com.anonymous.WhatsNearby",
      "infoPlist": {
        "NSMotionUsageDescription": "This app uses motion data to count your steps and show your progress toward your daily step goal."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCABPaBddoeaVfI0q49pM5iLqRVCOF3xcE"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACTIVITY_RECOGNITION"
      ],
      "package": "com.anonymous.WhatsNearby"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
